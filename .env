# =========================================
# Variables de entorno - Proyecto WordPress
# =========================================

# --- Base de datos MySQL ---
MYSQL_ROOT_PASSWORD=RootPass2026!
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=WpUserPass2026!

# --- WordPress ---
WORDPRESS_DB_HOST=mysql_db:3306
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=WpUserPass2026!

# --- Puertos expuestos al host ---
WORDPRESS_PORT=8081
MYSQL_PORT=3306

# --- Nombres de contenedores ---
WORDPRESS_CONTAINER_NAME=wordpress_app
MYSQL_CONTAINER_NAME=mysql_db

# --- Red personalizada ---
NETWORK_NAME=wordpress_network
